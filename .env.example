# mock = backend tiruan di memori (demo, tanpa FastAPI)
# live = memanggil FastAPI di API_BASE_URL
API_MODE=mock
API_BASE_URL=http://localhost:8000

# Hanya mode mock: masa berlaku token demo (menit)
# MOCK_TOKEN_MINUTES=120

# Pendaftaran bidan belum ada di dokumen arsitektur v2.0. Isi false untuk
# menyembunyikan halaman /daftar dan semua tombol Daftar.
# REGISTRATION_ENABLED=true
