icalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565.0" y="1507.0" width="270" height="56" as="geometry"/></mxCell><mxCell id="c32" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="1600" width="40" height="40" as="geometry"/></mxCell><mxCell id="c33" value="Kirim respons ke bidan: pemeriksaan&lt;br&gt;tersimpan (+ kategori risiko jika ada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565.0" y="1697.0" width="270" height="66" as="geometry"/></mxCell><mxCell id="c34" value="Perbarui status_kirim riwayat_notifikasi&lt;br&gt;(terkirim / diterima / gagal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565.0" y="1849.0" width="270" height="62" as="geometry"/></mxCell><mxCell id="c35" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="684" y="1974" width="32" height="32" as="geometry"/></mxCell><mxCell id="c36" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;strokeWidth=1;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1980" width="20" height="20" as="geometry"/></mxCell><mxCell id="c37" value="WhatsApp Gateway meneruskan&lt;br&gt;pesan template ke ibu hamil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900.0" y="1505.