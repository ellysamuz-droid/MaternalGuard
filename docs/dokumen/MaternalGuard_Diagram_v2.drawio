;strokeColor=#5B4BC4;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="59.0" y="404.0" width="262" height="112" as="geometry"/></mxCell><mxCell id="c15" value="Tampilkan pesan kesalahan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBFF;strokeColor=#5B4BC4;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90.0" y="560.0" width="200" height="50" as="geometry"/></mxCell><mxCell id="c16" value="Bidan melihat hasil pemeriksaan&lt;br&gt;dan kategori risiko" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBFF;strokeColor=#5B4BC4;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70.0" y="1699.0" width="240" height="62" as="geometry"/></mxCell><mxCell id="c17" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="174" y="1814" width="32" height="32" as="geometry"/></mxCell><mxCell id="c18" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;strokeWidth=1;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="1820" width="20" height="20" as="geometry"/></mxCell><mxCell id="c19" value="Catatan: hasil lab protein urine dicatat&lt;br&gt;terpisah (POST /hasil-lab); sistem menentukan&lt;br&gt;proteinuria positif. Hasil lab dan keluhan&lt;br&gt;belum menjadi input model, keduanya&lt;br&gt;ditampilkan ke bidan sebagai pendukung&lt;br&gt;keputusan." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#B8A96A;strokeWidth=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="1900" width="260" height="130" as="geometry"/></mxCell><mxCell id="c20" value="Verifikasi password (bcrypt),&lt;br&gt;terbitkan JWT berumur pendek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575.0" y="195.0" width="250" height="50" as="geometry"/></mxCell><mxCell id="c21" value="Validasi data dan cek ibu milik&lt;br&gt;bidan (id_bidan dari token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575.0" y="430.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Data valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="605.0" y="545.0" width="190" height="80" as="geometry"/></mxCell><mxCell id="c23" value="Simpan pemeriksaan, vital, detail keluhan&lt;br&gt;(1 transaksi, commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565.0" y="674.0" width="270" height="62" as="geometry"/></mxCell><mxCell id="c24" value="Hitung skor risiko: konversi satuan,&lt;br&gt;fitur turunan, prediksi model .pkl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565.0" y="779.0" width="270" height="62" as="geometry"/></mxCell><mxCell id="c25" value="Skoring berhasil?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600.0" y="880.0" width="200" height="80" as="geometry"/></mxCell><mxCel