0" y="235.0" width="220" height="50" as="geometry"/></mxCell><mxCell id="c44" value="Ambil jadwal aktif yang jatuh&lt;br&gt;tempo dari database, kunci baris" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180.0" y="335.0" width="240" height="70" as="geometry"/></mxCell><mxCell id="c45" value="Ada jadwal jatuh tempo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190.0" y="450.0" width="220" height="80" as="geometry"/></mxCell><mxCell id="c46" value="persetujuan_wa true,&lt;br&gt;nomor valid (62...),&lt;br&gt;ibu belum lahir?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1175.0" y="590.0" width="250" height="100" as="geometry"/></mxCell><mxCell id="c47" value="Hentikan&lt;br&gt;jadwal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1465.0" y="612.0" width="120" height="56" as="geometry"/></mxCell><mxCell id="c48" value="Pilih template tema berikutnya&lt;br&gt;(bergilir), isi nama ibu, nama &amp;&lt;br&gt;no_hp bidan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180.0" y="740.0" width="240" height="70" as="geometry"/></mxCell><mxCell id="c49" value="Catat riwayat_notifikasi (menunggu),&lt;br&gt;majukan jadwal kirim berikutnya" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;fontColor