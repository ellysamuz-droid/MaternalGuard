# Salin file ini menjadi ".env" (di folder backend, sejajar docker-compose.yml), lalu ganti nilainya.
# Buat/ubah file dengan VS Code atau Notepad (UTF-8). JANGAN membuatnya dengan "echo > .env" di PowerShell.

# Hanya huruf dan angka (tanpa simbol), karena dipakai di dalam alamat koneksi database.
POSTGRES_PASSWORD=ganti-dengan-huruf-dan-angka

# Teks acak minimal 32 karakter.
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
