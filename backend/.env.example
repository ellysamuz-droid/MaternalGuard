# ---- Wajib ----
# Di Railway: isi dengan referensi ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maternalguard
# Rahasia penanda tangan JWT. Buat acak panjang: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang

# ---- Umum ----
ENVIRONMENT=development          # production di server
JWT_EXPIRE_MINUTES=60            # JWT berumur pendek (NFR-01)
ALLOWED_ORIGINS=http://localhost:3000   # pisahkan koma; domain Vercel Anda
ENABLE_DOCS=true                 # false untuk menyembunyikan /docs di produksi
REGISTRATION_ENABLED=true        # POST /auth/register
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=5
MODEL_PATH=models/model_final.pkl

# ---- Jadwal pesan (keputusan terbuka nomor 4, bisa diubah) ----
JADWAL_HARI=selasa,jumat         # hari kirim tetap, zona WIB
JADWAL_JAM=10:00
PESAN_PERTAMA_MIN_JEDA_HARI=2    # pesan terjadwal pertama minimal N hari setelah pesan langsung

# ---- Proteinuria positif (HARUS dikonfirmasi tenaga medis) ----
PROTEIN_DIPSTIK_MIN=+1
PROTEIN_24JAM_MIN_G=0.3
PROTEIN_RASIO_MIN=0.3

# ---- WhatsApp ----
WHATSAPP_PROVIDER=fake           # fake | cloud
WA_MAX_RETRY=3
WA_RETRY_DELAY_SECONDS=2
# Hanya untuk WHATSAPP_PROVIDER=cloud:
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=                   # untuk memverifikasi tanda tangan webhook
WA_VERIFY_TOKEN=                 # token verifikasi webhook (Anda tentukan sendiri)
WA_API_VERSION=v21.0
WA_TEMPLATE_LANGUAGE=id
